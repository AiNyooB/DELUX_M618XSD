<Window x:Class="MouseDriverClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MouseDriverClient"
        Title="M618XSD 鼠标驱动" Height="680" Width="780"
        FontFamily="Segoe UI" FontSize="13" Background="#F0F4F8" Foreground="#000000">
    <Window.Resources>
        <!-- 浅色高对比主题：避免黑字配黑底看不见的问题 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#DCE6F1"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#7F9DB9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C2D5EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#7F9DB9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#003366"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#7F9DB9"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：连接状态 -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" FontSize="18" FontWeight="Bold" Text="DELUX M618XSD 驱动" Foreground="#003366"/>
            <Button DockPanel.Dock="Right" x:Name="BtnConnect" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCmd}" Width="110"/>
            <Ellipse DockPanel.Dock="Right" x:Name="LedStatus" Width="12" Height="12" Margin="0,0,10,0" Fill="#999" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" x:Name="TxtStatus" Text="未连接" Margin="0,0,8,0" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- 设备信息 -->
        <GroupBox Grid.Row="1" Header="设备">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VID: 0x1D57   PID: 0xFA60   (2.4G Wireless Device)" FontWeight="SemiBold"/>
                <Button x:Name="BtnFactory" Content="复位程序配置" ToolTip="仅清空本程序内存中的配置副本，不触发设备掉电/硬件复位；所用默认值为软件推断，未经抓包证实，未必等于设备真出厂值" Click="BtnFactory_Click" Margin="16,0,0,0"/>
                <Button x:Name="BtnExport" Content="导出配置" Click="BtnExport_Click" Margin="8,0,0,0"/>
                <Button x:Name="BtnImport" Content="导入配置" Click="BtnImport_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 中间：左侧导航 + 右侧内容区（两页切换） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <StackPanel Grid.Column="0" Background="#DCE6F1" Margin="0,0,8,0">
                <Button x:Name="NavDpi" Content="DPI 档位" Click="NavDpi_Click" Margin="6,6,6,2" Padding="6,8" Background="#3CB371" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="NavKey" Content="按键映射" Click="NavKey_Click" Margin="6,2,6,2" Padding="6,8"/>
                <Button x:Name="NavMacro" Content="宏管理" Click="NavMacro_Click" Margin="6,2,6,2" Padding="6,8"/>
                <Button x:Name="NavLightPower" Content="灯光与电源" Click="NavLightPower_Click" Margin="6,2,6,2" Padding="6,8"/>
                <Button x:Name="NavRate" Content="回报率" Click="NavRate_Click" Margin="6,2,6,2" Padding="6,8"/>
                <Button x:Name="NavBattery" Content="电池状态" Click="NavBattery_Click" Margin="6,2,6,2" Padding="6,8"/>
            </StackPanel>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">

                <!-- 第 1 页：DPI -->
                <Grid x:Name="PageDpi" Visibility="Visible">
                    <GroupBox Header="DPI 档位 (0x04)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnApplyDpi" Content="应用 DPI" Command="{Binding ApplyDpiCmd}" IsEnabled="{Binding IsConnected}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button x:Name="BtnSwitchLevel" Content="切档" Command="{Binding SwitchLevelCmd}" CommandParameter="{Binding CurrentLevel}" IsEnabled="{Binding IsConnected}" Margin="0,0,6,0" Padding="10,4" Background="#BFE3FF"/>
                                <TextBlock Text="点右侧「激活」选档 → 点「切档」写入" VerticalAlignment="Center" FontSize="11" Foreground="#555"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                <ItemsControl x:Name="DpiList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="4" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="启用此档"/>
                                                    <TextBlock Text="{Binding Label}" Width="52" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Value}" Width="56" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="DPI" VerticalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,10,0"/>
                                                    <RadioButton IsChecked="{Binding IsActive, Mode=OneWay}" GroupName="ActiveDpi"
                                                                 Checked="DpiActive_Checked" Width="64" VerticalAlignment="Center">
                                                        <RadioButton.Style>
                                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                                <Setter Property="Content" Value="设为激活"/>
                                                                <Setter Property="Background" Value="#E8EEF5"/>
                                                                <Setter Property="BorderBrush" Value="#7F9DB9"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Setter Property="Padding" Value="6,2"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="Content" Value="● 已激活"/>
                                                                        <Setter Property="Background" Value="#3CB371"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                        <Setter Property="BorderBrush" Value="#2E8B57"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </RadioButton.Style>
                                                    </RadioButton>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <!-- 第 2 页：按键映射 -->
                <Grid x:Name="PageKey" Visibility="Collapsed">
                    <GroupBox Header="按键映射 (0x08) — 已打通">
                        <StackPanel>
                            <TextBlock Text="✅ 标准功能改键已实机验证通过。默认走轻量序列（0x0C→0x08，不写 DPI）；如需同步当前 DPI 面板值，取消勾选下方「轻量序列」即用完整序列。选中「功能=宏」后，在下方选择一个已在「宏管理」页录制好的宏 ID 绑定（下拉仅列出已录制的宏）。" Foreground="#006600" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock Text="选择按钮：" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbButton" Width="200" HorizontalAlignment="Left" SelectionChanged="CmbButton_SelectionChanged"/>
                            <TextBlock Text="功能：" Margin="0,8,0,4"/>
                            <ComboBox x:Name="CmbFunc" Width="200" HorizontalAlignment="Left" SelectionChanged="CmbFunc_SelectionChanged"/>
                            <GroupBox x:Name="GrpKeyMacro" Header="绑定宏到本键" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="绑定宏 ID:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CmbKeyMacroId" Width="180" SelectionChanged="CmbKeyMacroId_SelectionChanged"/>
                                        <Button x:Name="BtnGoMacro" Content="去宏管理页录制" Click="BtnGoMacro_Click" Margin="8,0,0,0" Padding="8,2"/>
                                    </StackPanel>
                                    <TextBlock Text="宏内容请在「宏管理」页录制，录制后回到本页即可在上方选择对应宏 ID 绑定。" FontSize="11" Foreground="#006600" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                            <CheckBox x:Name="ChkLightweightKey" Content="轻量序列（不写 DPI）" IsChecked="{Binding ButtonLightweight}" Margin="0,12,0,4"/>
            <Button x:Name="BtnApplyBtn" Content="应用按键" Command="{Binding ApplyButtonCmd}" IsEnabled="{Binding IsConnected}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtBtnRaw" Text="原始 3 字节: --" Margin="0,8,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 第 3 页：宏管理（放在右栏 Grid.Column=1 内，与 PageDpi/PageKey 平级） -->
                <Grid x:Name="PageMacro" Grid.Column="1" Visibility="Collapsed">
                    <GroupBox Header="宏管理 (0x09) — 已打通">
                        <StackPanel>
                            <TextBlock Text="✅ 宏录制已实机验证。本页只负责录制一串动作并保存到宏库，本身不含任何物理按键绑定。录制后，请到「按键映射」页把某键「功能」设为「宏」、再在『绑定宏 ID』下拉选中本宏，即可完成绑键并写入设备。" Foreground="#006600" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <local:MacroEditor x:Name="MacroEditor" Margin="0,4,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="循环次数：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtLoop" Width="70" VerticalContentAlignment="Center">0</TextBox>
                                <TextBlock Text="（≥1 次；0 会被固件当作 1；仅循环次数播放方式生效）" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#666"/>
                            </StackPanel>

                <Button x:Name="BtnSaveMacro" Content="保存宏" Click="BtnSaveMacro_Click" Margin="0,0,0,6" HorizontalAlignment="Left" Padding="12,4" Background="#FFE0B2" FontWeight="Bold"/>
                <TextBlock Text="录制动作后点「保存宏」把本宏提交到宏库；再到「按键映射」页把某键「功能」设为「宏」，即可在『绑定宏 ID』下拉中看到本宏并选中绑定。" FontSize="11" Foreground="#006600" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 灯光与电源（0x05 整报告：灯光 + 电源 + 去抖 三项打包，竖排分区） -->
                <Grid x:Name="PageLightPower" Visibility="Collapsed">
                    <GroupBox Header="灯光与电源 (0x05) — 已打通">
                        <DockPanel>
                            <!-- 顶部整报告提示条 -->
                            <Border DockPanel.Dock="Top" Background="#FFF6E0" BorderBrush="#E0A000" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,10">
                                <TextBlock Text="⚠ 0x05 为整报告：灯光、电源（睡眠/一级休眠）、去抖三项打包在同一命令中。点任一「应用」按钮，都会把当前三项的全部值一并写入设备。修改单项后请确认 Mouse.exe 已完全退出。" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 区1：灯光 -->
                                    <GroupBox Header="灯光" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="灯光模式：" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LightModeOptions}"
                                                      DisplayMemberPath="Text" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Light.Mode}" Margin="0,0,0,6"/>
                                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                      Content="移动时关灯" IsChecked="{Binding Light.MoveOff}" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="呼吸速度：" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Slider Grid.Row="2" Grid.Column="1" x:Name="SldBreath"
                                                    Value="{Binding Light.BreathSpeed}" Minimum="4" Maximum="8"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Width="40" VerticalAlignment="Center" Margin="0,0,0,6"
                                                       Text="{Binding Value, ElementName=SldBreath}"/>
                                            <Button Grid.Row="3" Grid.Column="0" Content="应用灯光" Command="{Binding ApplyLightCmd}"
                                                    HorizontalAlignment="Left" Padding="10,4" Background="#FFE0B2"/>
                                        </Grid>
                                    </GroupBox>
                                    <!-- 区2：电源管理 -->
                                    <GroupBox Header="电源管理（睡眠 / 一级休眠）" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="睡眠时间：" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Slider Grid.Row="0" Grid.Column="1" x:Name="SldSleep"
                                                    Value="{Binding Light.SleepMinutes}" Minimum="1" Maximum="60"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Width="60" VerticalAlignment="Center" Margin="0,0,0,6"
                                                       Text="{Binding Value, ElementName=SldSleep, StringFormat={}{0} 分}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="一级休眠：" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Slider Grid.Row="1" Grid.Column="1" x:Name="SldL1Sleep"
                                                    Value="{Binding Light.Level1SleepMinutes}" Minimum="0.5" Maximum="60"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Width="60" VerticalAlignment="Center" Margin="0,0,0,6"
                                                       Text="{Binding Value, ElementName=SldL1Sleep, StringFormat={}{0} 分}"/>
                                            <Button Grid.Row="2" Grid.Column="0" Content="应用电源" Command="{Binding ApplyLightCmd}"
                                                    HorizontalAlignment="Left" Padding="10,4" Background="#FFE0B2"/>
                                        </Grid>
                                    </GroupBox>
                                    <!-- 区3：去抖 -->
                                    <GroupBox Header="按键响应 / 去抖" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="去抖(ms)：" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Slider Grid.Row="0" Grid.Column="1" x:Name="SldDebounce"
                                                    Value="{Binding Light.DebounceMs}" Minimum="1" Maximum="25"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Width="60" VerticalAlignment="Center" Margin="0,0,0,6"
                                                       Text="{Binding Value, ElementName=SldDebounce, StringFormat={}{0} ms}"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="应用去抖" Command="{Binding ApplyLightCmd}"
                                                    HorizontalAlignment="Left" Padding="10,4" Background="#FFE0B2"/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <!-- 第 6 页：回报率（独立模块） -->
                <Grid x:Name="PageRate" Visibility="Collapsed">
                    <GroupBox Header="回报率 (0x06) — 已打通">
                        <StackPanel>
                            <TextBlock Text="✅ 回报率已通过抓包验证。修改后点「应用回报率」写入（自动先发唤醒 0x0C）。" Foreground="#006600" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="回报率：" Width="80" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbRate" Width="160" ItemsSource="{Binding RateOptions}"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Rate.Hz}"/>
                            </StackPanel>
                            <Button x:Name="BtnApplyRate" Content="应用回报率" Command="{Binding ApplyRateCmd}" IsEnabled="{Binding IsConnected}" HorizontalAlignment="Left" Padding="10,4" Margin="0,4,0,0" Background="#FFE0B2"/>
                            <TextBlock Text="⚠ 应用前请确认官方 Mouse.exe 已完全退出；本命令必须与唤醒(0x0C)同发，单发会破坏设备状态。" Foreground="#B00000" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 第 7 页：电池状态（只读，来自 Input Report 03 28 40 XX YY，约 2 秒上报一次） -->
                <Grid x:Name="PageBattery" Visibility="Collapsed">
                    <GroupBox Header="电池状态 (Input Report 03 28 40 XX YY) — 只读">
                        <StackPanel Margin="8">
                            <TextBlock Text="📡 电池状态由设备周期性（约 2 秒）主动上报，无需向设备下发任何命令。仅当数据设备(0x0A)已打开并监听 Input Report 时显示。" Foreground="#006600" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="电量：" Width="60" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold" Foreground="#1A7A1A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="充电状态：" Width="80" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BatteryChargeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="⚠ 数值为设备直读，未做修正；插线充电时电量会上升。" Foreground="#888" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

            </Grid>
        </Grid>

        <!-- 日志 -->
        <GroupBox Grid.Row="3" Header="日志" Height="140">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" IsUndoEnabled="False" Background="#FFFFFF" Foreground="#000000" BorderThickness="1" BorderBrush="#7F9DB9" FontFamily="Consolas" FontSize="11" Text="{Binding LogText, Mode=OneWay}"/>
        </GroupBox>
    </Grid>
</Window>
