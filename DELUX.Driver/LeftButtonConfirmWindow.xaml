<Window x:Class="DeluxDriver.LeftButtonConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改左键"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="{DynamicResource ScrimBackgroundBrush}">
    <!-- 左键改键风险确认（MainWindow.UpdateLeftBtnConfirm 创建并定位到主窗口外框）。
         半透明遮罩 = 窗口背景（ScrimBackgroundBrush，对齐 WPF-UI ContentDialogSmokeFill 的 30% 黑）。
         ⚠️ 必须 AllowsTransparency="True"：独立 Window 不开它时 alpha 被丢弃，半透明黑会显示成纯黑
         （历史事故，见 ADR）；它要求 WindowStyle=None + ResizeMode=NoResize（上方已满足）。
         遮罩覆盖含标题栏的整个主窗口并拦截底层点击；居中卡片 = 不透明实底 + 无描边。 -->
    <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            CornerRadius="{DynamicResource OverlayCornerRadius}"
            MaxWidth="360" Padding="24,20"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <!-- 柔和环境阴影（参数对齐 ComboBox 弹层，见 Themes/Styles.xaml） -->
            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="{DynamicResource BodyLargeTextBlockFontSize}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="修改左键" Style="{DynamicResource CardTitleTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding LeftBtnConfirmText}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding LeftBtnConfirmCancelCmd}" Margin="0,0,12,0" IsCancel="True" />
                <Button x:Name="OkButton" Content="我知道了" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding LeftBtnConfirmOkCmd}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
