<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题画刷（原生 WPF，等价于 WPF Gallery 的深色 Fluent 观感） -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SubForegroundBrush" Color="#B5B5B5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#102030" />
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#0B3A57" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#3A3A3A" />

    <!-- Fluent 主题画刷覆盖：使 Fluent 的 AccentButtonStyle 使用我们的品牌色 -->
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#102030" />
</ResourceDictionary>
