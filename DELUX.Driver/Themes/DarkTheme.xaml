<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         深色主题 — 语义颜色令牌（对齐 Windows 11 Fluent / WinUI 命名）
         来源：Fluent.Dark.xaml（.NET 10 Fluent 主题）+ Windows 设计规范；
               品牌色为 DELUX 蓝（深色模式 #4CC2FF）。
         ===================================================================== -->

    <!-- ── 文字填充（TextFill） ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#E4000000" />

    <!-- 强调色上的文字（AccentTextFill / TextOnAccent） -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#6BCDFF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#82D5FF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#102030" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#80102030" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#102030" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF" />

    <!-- ── 背景（Application / SolidBackground） ────────────────────────── -->
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#202020" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#0A0A0A" />

    <!-- 卡片/层背景（Card / Layer） -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDimmedBrush" Color="#3A3A3A" />
    <!-- 左栏/导航区「非活动」态：半透明灰图层，叠在 Mica 上仍透出 DWM 背景（Fluent 内容层规范：低不透明度纯色）。仅左栏变灰用，不改全局 Dimmed。 -->
    <SolidColorBrush x:Key="PaneDimmedFillBrush" Color="#663A3A3A" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0DFFFFFF" />

    <!-- ── 控件填充（ControlFill / SubtleFill / ControlAltFill） ────────── -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#B31E1E1E" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#3FFFFFFF" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#454545" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#19000000" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#00FFFFFF" />

    <!-- ── 强调色（Accent，品牌色 DELUX 蓝） ────────────────────────────── -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6BCDFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#82D5FF" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#4CC2FF" />

    <!-- ── 描边（ControlStroke / CardStroke / Divider） ─────────────────── -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3000000" />

    <!-- ── 系统状态色（SystemFill，成功/警告/错误） ─────────────────────── -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#393D1B" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#433519" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#08FFFFFF" />

    <!-- ── 键盘焦点边框 ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#87FFFFFF" />

    <!-- ── 遮罩（Scrim，模态弹窗背景，半透明黑——对齐 WPF-UI ContentDialogSmokeFill #4D000000 30% 黑，浅深同值） ── -->
    <SolidColorBrush x:Key="ScrimBackgroundBrush" Color="#4D000000" />

    <!-- ════════════════════════════════════════════════════════════════════
         旧键兼容别名（渐进迁移期保留；新代码一律使用上方 Fluent 语义键）
         ════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubForegroundBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#102030" />
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#0B3A57" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#0BFFFFFF" />

    <!-- ── DPI 档位指示灯色（模拟硬件 DPI 键的 LED 色，与鼠标 DPI 键灯一一对应；见 M618XSD驱动功能Wiki.md 3.2 节） ── -->
    <!-- 深色背景（深色卡片）上提亮饱和度/明度，避免与背景同化、保证辨识度。 -->
    <SolidColorBrush x:Key="DpiStage1IndicatorBrush" Color="#FF4D5E" />
    <SolidColorBrush x:Key="DpiStage2IndicatorBrush" Color="#4BD865" />
    <SolidColorBrush x:Key="DpiStage3IndicatorBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DpiStage4IndicatorBrush" Color="#B07DFF" />
    <SolidColorBrush x:Key="DpiStage5IndicatorBrush" Color="#FFC94D" />

    <!-- Fluent AccentButtonStyle 品牌色覆盖（深色） -->
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#102030" />
</ResourceDictionary>
