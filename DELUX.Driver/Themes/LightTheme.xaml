<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题画刷（原生 WPF，等价于 WPF Gallery 的浅色 Fluent 观感） -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SubForegroundBrush" Color="#606060" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#EAF3FB" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#F0F0F0" />

    <!-- Fluent 主题画刷覆盖：使 Fluent 的 AccentButtonStyle 使用我们的品牌色 -->
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
