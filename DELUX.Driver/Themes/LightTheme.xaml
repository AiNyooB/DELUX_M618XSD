<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         浅色主题 — 语义颜色令牌（对齐 Windows 11 Fluent / WinUI 命名）
         来源：Fluent.Light.xaml（.NET 10 Fluent 主题）+ Windows 设计规范；
               品牌色为 DELUX 蓝（#0067C0）。
         ===================================================================== -->

    <!-- ── 文字填充（TextFill） ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFF" />

    <!-- 强调色上的文字（AccentTextFill / TextOnAccent） -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#004D94" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4C8CC9" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FFFFFF" />

    <!-- ── 背景（Application / SolidBackground） ────────────────────────── -->
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#DADADA" />

    <!-- 卡片/层背景（Card / Layer） -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDimmedBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF" />

    <!-- ── 控件填充（ControlFill / SubtleFill / ControlAltFill） ────────── -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72000000" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#51000000" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#06000000" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#18000000" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#00FFFFFF" />

    <!-- ── 强调色（Accent，品牌色 DELUX 蓝） ────────────────────────────── -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2E7ACC" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#337CC6" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#0067C0" />

    <!-- ── 描边（ControlStroke / CardStroke / Divider） ─────────────────── -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3FFFFFF" />

    <!-- ── 系统状态色（SystemFill，成功/警告/错误） ─────────────────────── -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#72000000" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#06000000" />

    <!-- ── 键盘焦点边框 ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#BE000000" />

    <!-- ── 遮罩（Scrim，模态弹窗背景，半透明黑——对齐 WPF-UI ContentDialogSmokeFill #4D000000 30% 黑） ── -->
    <SolidColorBrush x:Key="ScrimBackgroundBrush" Color="#4D000000" />

    <!-- ════════════════════════════════════════════════════════════════════
         旧键兼容别名（渐进迁移期保留；新代码一律使用上方 Fluent 语义键）
         ════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="SubForegroundBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="BorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#EAF3FB" />
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#0F000000" />

    <!-- ── DPI 档位指示灯色（模拟硬件 DPI 键的 LED 色，与鼠标 DPI 键灯一一对应；见 M618XSD驱动功能Wiki.md 3.2 节） ── -->
    <!-- 浅色背景（白卡片）上使用标准饱和色，保证辨识度。 -->
    <SolidColorBrush x:Key="DpiStage1IndicatorBrush" Color="#E81123" />
    <SolidColorBrush x:Key="DpiStage2IndicatorBrush" Color="#1A9E3E" />
    <SolidColorBrush x:Key="DpiStage3IndicatorBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="DpiStage4IndicatorBrush" Color="#8A4BD8" />
    <SolidColorBrush x:Key="DpiStage5IndicatorBrush" Color="#E0A000" />

    <!-- Fluent AccentButtonStyle 品牌色覆盖（浅色） -->
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
