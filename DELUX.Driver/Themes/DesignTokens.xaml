<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         设计令牌（Design Tokens）— 补充层
         对齐 Windows 11 Fluent 规范（learn.microsoft.com/windows/apps/design/）
         与 WPF Gallery（WinUI 语义命名）。
         · 基础字体/字号/圆角等已由 PresentationFramework.Fluent 与
           PageStyles.xaml 提供，本字典只补充项目所需的专属令牌；
         · 本字典不含任何主题色，浅/深色差异全部由
           LightTheme.xaml / DarkTheme.xaml 承载。
         ===================================================================== -->

    <!-- ── 字体 ─────────────────────────────────────────────────────────── -->
    <!-- Segoe UI Variable 为 Windows 11 系统字体；WPF 中以 "Variable, Segoe UI" 回退。 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <!-- ── 字号补充 ─────────────────────────────────────────────────────── -->
    <!-- BodyLarge 为 Windows 排版渐变中位于 Body(14) 与 Subtitle(20) 之间的层级。 -->
    <sys:Double x:Key="BodyLargeTextBlockFontSize">18</sys:Double>

    <!-- ── 圆角（Fluent 几何规范） ──────────────────────────────────────── -->
    <!-- 项目专属：卡片、侧边导航项、图片容器。
         控件/弹层圆角（ControlCornerRadius=4 / OverlayCornerRadius=8 /
         PopupCornerRadius=8）由 PresentationFramework.Fluent 提供。 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ImageCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="NavigationItemCornerRadius">6</CornerRadius>

    <!-- ── 边框宽度 ─────────────────────────────────────────────────────── -->
    <Thickness x:Key="ControlStrokeThickness">1</Thickness>
    <Thickness x:Key="FocusStrokeThickness">2</Thickness>
    <Thickness x:Key="SelectionStrokeThickness">2.5</Thickness>

    <!-- ── 间距（4px 基数的 Fluent 间距标度） ───────────────────────────── -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space48">48</sys:Double>

    <!-- ── 动效时长（Fluent 运动规范） ──────────────────────────────────── -->
    <Duration x:Key="ControlFasterAnimationDuration">00:00:00.083</Duration>
    <Duration x:Key="ControlFastAnimationDuration">00:00:00.167</Duration>
    <Duration x:Key="ControlNormalAnimationDuration">00:00:00.250</Duration>
    <Duration x:Key="ControlSlowAnimationDuration">00:00:00.500</Duration>
    <!-- 标准加速曲线（快进慢出）。 -->
    <sys:String x:Key="ControlFastOutSlowInKeySpline">0,0,0,1</sys:String>

</ResourceDictionary>
