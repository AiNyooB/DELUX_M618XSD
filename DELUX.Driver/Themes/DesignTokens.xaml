<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         设计令牌（Design Tokens）— 补充层
         对齐 Windows 11 Fluent 规范（learn.microsoft.com/windows/apps/design/）
         与 WPF Gallery（WinUI 语义命名）。
         · 基础字体/字号/圆角等已由 PresentationFramework.Fluent 与
           PageStyles.xaml 提供，本字典只补充项目所需的专属令牌；
         · 本字典不含任何主题色，浅/深色差异全部由
           LightTheme.xaml / DarkTheme.xaml 承载。
         ===================================================================== -->

    <!-- ── 字体 ─────────────────────────────────────────────────────────── -->
    <!-- Segoe UI Variable 为 Windows 11 系统字体；WPF 中以 "Variable, Segoe UI" 回退。 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <!-- ── 字号补充 ─────────────────────────────────────────────────────── -->
    <!-- BodyLarge 为 Windows 排版渐变中位于 Body(14) 与 Subtitle(20) 之间的层级。 -->
    <sys:Double x:Key="BodyLargeTextBlockFontSize">18</sys:Double>

    <!-- ── 圆角（Fluent 几何规范） ──────────────────────────────────────── -->
    <!-- 项目专属：卡片、侧边导航项、图片容器。
         控件/弹层圆角（ControlCornerRadius=4 / OverlayCornerRadius=8 /
         PopupCornerRadius=8）由 PresentationFramework.Fluent 提供。 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ImageCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="NavigationItemCornerRadius">6</CornerRadius>

    <!-- ── 边框宽度 ─────────────────────────────────────────────────────── -->
    <Thickness x:Key="ControlStrokeThickness">1</Thickness>
    <Thickness x:Key="FocusStrokeThickness">2</Thickness>
    <Thickness x:Key="SelectionStrokeThickness">2.5</Thickness>

    <!-- ── 间距（4px 基数的 Fluent 间距标度） ───────────────────────────── -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <!-- 间距令牌供 Margin/Padding 直接引用，故为均匀 Thickness（历史事故：曾定义为 sys:Double，
         用于 Margin 时布局抛 "XX不是属性Margin的有效值"，启动即崩） -->
    <Thickness x:Key="Space2">2</Thickness>
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space48">48</Thickness>
    <Thickness x:Key="ActionRowGap">0,8,0,0</Thickness>

    <!-- ── 单边 / 组合间距令牌（供 Margin/Padding 直接引用，避免重复写死数字） ── -->
    <Thickness x:Key="MarginLeft8">8,0,0,0</Thickness>
    <Thickness x:Key="MarginLeft12">12,0,0,0</Thickness>
    <Thickness x:Key="MarginRight8">0,0,8,0</Thickness>
    <Thickness x:Key="MarginTop2">0,2,0,0</Thickness>
    <Thickness x:Key="MarginTop4">0,4,0,0</Thickness>
    <Thickness x:Key="MarginTop8">0,8,0,0</Thickness>
    <Thickness x:Key="MarginTop10">0,10,0,0</Thickness>
    <Thickness x:Key="MarginTop12">0,12,0,0</Thickness>
    <Thickness x:Key="MarginTop14">0,14,0,0</Thickness>
    <Thickness x:Key="MarginTop16">0,16,0,0</Thickness>
    <Thickness x:Key="MarginTop24">0,24,0,0</Thickness>
    <Thickness x:Key="MarginBottom8">0,0,0,8</Thickness>
    <Thickness x:Key="MarginBottom12">0,0,12,0</Thickness>
    <Thickness x:Key="MarginBottom16">0,0,16,0</Thickness>
    <Thickness x:Key="MarginRight18">0,0,18,0</Thickness>
    <Thickness x:Key="PaddingX12Y6">12,6</Thickness>
    <Thickness x:Key="PaddingX16Y8">16,8</Thickness>
    <Thickness x:Key="PaddingX12Y10">12,10</Thickness>
    <Thickness x:Key="PaddingX16Y10">16,10</Thickness>
    <Thickness x:Key="PaddingX8Y2">8,2</Thickness>
    <Thickness x:Key="PaddingX8Y3">8,3</Thickness>
    <Thickness x:Key="PaddingX8Y6">8,6</Thickness>
    <Thickness x:Key="PaddingX6Y2">6,2</Thickness>
    <Thickness x:Key="PaddingX6Y3">6,3</Thickness>
    <Thickness x:Key="PaddingX5Y1">5,1</Thickness>
    <Thickness x:Key="MarginLeft5">5,0,0,0</Thickness>
    <Thickness x:Key="MarginLeft10">10,0,0,0</Thickness>
    <Thickness x:Key="MarginRightBottom24">0,0,24,24</Thickness>

    <!-- ── 动效时长（Fluent 运动规范） ──────────────────────────────────── -->
    <Duration x:Key="ControlFasterAnimationDuration">00:00:00.083</Duration>
    <Duration x:Key="ControlFastAnimationDuration">00:00:00.167</Duration>
    <Duration x:Key="ControlNormalAnimationDuration">00:00:00.250</Duration>
    <Duration x:Key="ControlSlowAnimationDuration">00:00:00.500</Duration>
    <!-- 标准加速曲线（快进慢出）。 -->
    <sys:String x:Key="ControlFastOutSlowInKeySpline">0,0,0,1</sys:String>

</ResourceDictionary>
