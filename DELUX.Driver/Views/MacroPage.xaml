<Page x:Class="DeluxDriver.MacroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="快捷指令">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="快捷指令" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="录制一串按键动作，绑定到一个按键后一键自动连发。"
                       Style="{DynamicResource PageSubtitleTextStyle}"
                       Margin="0,4,0,16" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xE8C3;" Style="{DynamicResource IconStyle}" />
                    <TextBlock Text="快捷指令即将开放" Style="{DynamicResource CardTitleTextStyle}" Margin="0,12,0,4" />
                    <TextBlock Text="本模块将在「宏设置」阶段接入：新建宏、录制按键、设置循环次数与间隔。"
                               Style="{DynamicResource CardDescriptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
