<Page x:Class="DeluxDriver.LocalConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="本地配置">

    <!--
      布局（用户确认的精简版）：标题整宽置顶 + 单列窄列表（左对齐）。
      设备无配置槽位，Profile 为纯软件层（AGENTS.md §3.6）。
      每行只显示配置名称 + 「当前」徽章；删除按钮每行常驻占位（前 4 个排版基准槽隐藏，第 5 个起可见）。
    -->
    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 标题行（整宽）：页名 + 一句话说明 | 右侧新建 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本地配置" Style="{DynamicResource PageTitleTextStyle}" />
                            <TextBlock Text="保存多套设置，一键切换" Style="{DynamicResource PageSubtitleTextStyle}" Margin="{DynamicResource MarginTop4}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ 新建配置" Command="{Binding NewSlotCmd}"
                                Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 单列窄列表（左对齐，约 340px） -->
                    <ItemsControl ItemsSource="{Binding Slots}" Width="340" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 整行可点 = 切换（VM 内二次确认 + 进度 + 回滚）；
                                     用 Border.InputBindings 而非嵌套 Button，避免与行内删除按钮事件冲突 -->
                                <Border Margin="{DynamicResource MarginBottom8}" Padding="12,10"
                                        CornerRadius="{DynamicResource NavigationItemCornerRadius}"
                                        BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <!-- 悬停高亮（§5.15 卡片规范：ControlFillColorSecondaryBrush） -->
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                                <!-- 激活槽（§5.15 选中态）：描边强调色 1.5px + 浅强调色填充 -->
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SwitchSlotCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding .}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <!-- 「当前」徽章：仅激活槽显示 -->
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="3"
                                                    Padding="{DynamicResource PaddingX5Y1}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="当前" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <!-- 删除按钮：每行常驻占位（MinHeight=24 参与布局 → 所有行等高，新增可删槽不撑高前 4 行）；
                                             前 4 个排版基准槽 Opacity=0 + 禁点实现「占位不显示」（不能用 Collapsed，否则不占布局） -->
                                        <Button Grid.Column="1" Content="&#x2715;" Padding="6,3"
                                                MinWidth="28" MinHeight="24"
                                                FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                Command="{Binding DataContext.DeleteSlotCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding .}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeletable}" Value="False">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部状态行：切换写入生命周期（待确认 → 正在写入 1/8…8/8 → 已保存 ✓） -->
                    <TextBlock Text="{Binding SwitchProgress}" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                               Margin="4,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>