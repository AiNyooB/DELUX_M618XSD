<Page x:Class="DeluxDriver.ButtonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="改键设置">

    <Page.Resources>
        <DataTemplate x:Key="IconMarkerTemplate">
            <Grid Width="16" Height="16">
                <Ellipse Width="14" Height="14" Fill="Transparent"
                         Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Circle">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Path Stretch="None" Width="14" Height="14"
                      Fill="Transparent" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{Binding PathData}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowUp">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowDown">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowLeft">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowRight">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <!-- 编号徽标：右上角小圆点 + 编号，与标签右上角编号一一对应。 -->
                <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="{Binding Index}" FontSize="7.5" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
                           Width="10" TextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 页面级大卡（与其他内容页一致）。内部：左栏鼠标图始终占满、不缩放；
         点击按键标签后右栏（分配功能）以覆盖层从右侧盖上来（图片平移被遮，不缩小）。 -->
    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <!-- ===== 左栏：鼠标示意图（放大）+ 10 个按键热点标签 =====
                     图片与标签同处 300×506 的 Canvas（图片原始尺寸坐标系，已裁掉左右透明区）。
                     缩放用 LayoutTransform（Scale 由 code-behind 按可用区域计算，跟随窗口、
                     但不随右栏出现而变化——右栏出现时图片保持原尺寸，仅水平对齐从居中变为靠左，
                     整体平移、右侧让位被右栏盖住，绝不缩小）。
                     标签坐标保持 300 系（Canvas.Left/Top），微调位置只改数值。 -->
                <Grid x:Name="CardHost" Margin="16" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 660×660 坐标系 Canvas，LayoutTransform 整体缩放（Scale 由 code-behind 设置）。
                         水平对齐：右栏收起时居中；右栏（覆盖层）出现时靠左平移（尺寸不变）。 -->                        <Canvas x:Name="MouseCanvas" Width="300" Height="506" VerticalAlignment="Center">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="MouseScale" />
                        </Canvas.LayoutTransform>
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <!-- （负 Margin 已撤销：图片左右透明区大，等用户裁掉透明区后仅靠左即可） -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>                        </Canvas.Style>                        <!-- 诊断边框：红色框 = 图片实际边界（300×506 随缩放）。确认布局后移除。 -->
                        <Rectangle Width="300" Height="506" Fill="Transparent"
                                   Stroke="Red" StrokeThickness="3" IsHitTestVisible="False" />
                        <!-- 鼠标示意图（外观随「其他设置」的产品外观切换） -->
                        <Image Source="{Binding AppearanceImageUri}" Width="300" Height="506" />

                            <ItemsControl x:Name="IconsHost" ItemsSource="{Binding IconMarkers}"
                                          ItemTemplate="{StaticResource IconMarkerTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!-- 10 个可编程按键标签（660 系坐标，点击选中）。
                                 坐标基于图片轮廓估算，实机微调时改 Canvas.Left/Top 数值即可。 -->
                            <ItemsControl x:Name="TagsHost" ItemsSource="{Binding Buttons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="BtnTag" Width="96"
                                                     Style="{DynamicResource ButtonTagStyle}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     ToolTip="{Binding Name}"
                                                     Command="{Binding DataContext.SelectButtonCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     CommandParameter="{Binding Index}">
                                            <Grid>
                                                <TextBlock Text="{Binding FunctionName}" FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,0,20,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <!-- 编号徽标：右上角，与位置图标上的编号一一对应。 -->
                                                <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="{Binding IconIndex}" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Width="16" TextAlignment="Center" />
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding TagX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding TagY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                    </Canvas>

                    <!-- 保存状态反馈 -->
                    <TextBlock Grid.Row="1" Text="{Binding SaveStatusText}" FontSize="11" Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ===== 右栏：分配功能面板（默认隐藏）。覆盖层——盖在左栏右侧，
                     左栏图片保持原尺寸平移被遮，不缩小。无独立背景，直接显示在大卡背景上。 ===== -->
                <Grid HorizontalAlignment="Right" Width="320" Panel.ZIndex="1"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <!-- 左缘竖分隔线：区分功能面板 -->
                    <Border Width="1" HorizontalAlignment="Left" Margin="0,16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ScrollViewer Margin="20,16,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="分配功能" Style="{DynamicResource CardTitleTextStyle}" />
                                <TextBlock Text="{Binding SelectedButton.Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <TabControl Margin="0,12,0,0" SelectedIndex="{Binding FuncTabIndex, Mode=OneWay}">
                                <!-- 鼠标操作 Tab：11 个已验证功能（含 DPI 循环） -->
                                <TabItem Header="鼠标操作">
                                    <ItemsControl ItemsSource="{Binding FuncOptions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="BtnFunc" Content="{Binding Name}" Margin="0,2"
                                                             IsChecked="{Binding IsChecked}"
                                                             Command="{Binding DataContext.SetFuncCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                             CommandParameter="{Binding Code}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>

                                <!-- 宏 Tab：宏列表单选展示（不用下拉框）；列表为空时显示空态提示 -->
                                <TabItem Header="宏">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="选择宏" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <!-- 空态：宏列表为空时提示 -->
                                        <TextBlock Text="暂无宏，请到「快捷指令」页创建" FontSize="11" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 宏列表：每项单选，选中即绑定当前按钮的宏 ID -->
                                        <ItemsControl ItemsSource="{Binding Macros}" Margin="0,4,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="BtnMacro" Content="{Binding Name}" Margin="0,2"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Command="{Binding DataContext.SetMacroCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                 CommandParameter="{Binding Id}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="宏的具体内容请在「快捷指令」页编辑（后续版本支持）" FontSize="11"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- 未逆向功能的说明（置灰原则：未确认编码绝不上 UI） -->
                            <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="4"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="DPI+ / 快捷键 / 多媒体 / 浏览器等功能等待协议补齐，暂不提供。"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
