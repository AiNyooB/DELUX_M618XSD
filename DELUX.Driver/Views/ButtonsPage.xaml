<Page x:Class="DeluxDriver.ButtonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="改键设置">

    <Page.Resources>
        <DataTemplate x:Key="IconMarkerTemplate">
            <!-- 普通态中性灰描边；选中态切强调色、描边加粗（由 IconMarker.IsSelected 驱动） -->
            <Grid Width="20" Height="20">
                <Ellipse Width="14" Height="14" Fill="Transparent">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Circle">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Path Stretch="None" Width="14" Height="14"
                      Fill="Transparent"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{Binding PathData}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowUp">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowDown">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowLeft">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ArrowRight">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 页面级大卡（与其他内容页一致）。内部：左栏鼠标图始终占满、不缩放；
         点击按键标签后右栏（分配功能）以覆盖层从右侧盖上来（图片平移被遮，不缩小）。 -->
    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <!-- ===== 左栏：鼠标示意图（放大）+ 10 个按键热点标签 =====
                     图片与标签同处 300×506 的 Canvas（图片原始尺寸坐标系，已裁掉左右透明区）。
                     缩放用 LayoutTransform（Scale 由 code-behind 按可用区域计算，跟随窗口、
                     但不随右栏出现而变化——右栏出现时图片保持原尺寸，仅水平对齐从居中变为靠左，
                     整体平移、右侧让位被右栏盖住，绝不缩小）。
                     标签坐标保持 300 系（Canvas.Left/Top），微调位置只改数值。 -->
                <Grid x:Name="CardHost" Margin="16" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>                        <!-- 300×506 坐标系 Canvas，LayoutTransform 整体缩放（Scale 由 code-behind 设置）。
                             水平位置由 code-behind 计算（UpdateCanvasPosition）：无右栏 → 居中于整卡；
                             有右栏 → 居中于右栏左侧可用区。自适应宽度，不再写死 70px 平移——
                             侧边栏/窗口宽度变化时不会出现图片与右栏间的异常空隙。 -->
                        <Canvas x:Name="MouseCanvas" Width="300" Height="506" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="MouseScale" />
                        </Canvas.LayoutTransform>
                        <!-- 鼠标示意图（外观随「其他设置」的产品外观切换） -->
                        <Image Source="{Binding AppearanceImageUri}" Width="300" Height="506" />

                            <ItemsControl x:Name="IconsHost" ItemsSource="{Binding IconMarkers}"
                                          ItemTemplate="{StaticResource IconMarkerTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!-- 10 个可编程按键标签（660 系坐标，点击选中）。
                                 坐标基于图片轮廓估算，实机微调时改 Canvas.Left/Top 数值即可。 -->
                            <ItemsControl x:Name="TagsHost" ItemsSource="{Binding Buttons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="BtnTag" Width="Auto"
                                                     Style="{DynamicResource ButtonTagStyle}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     ToolTip="{Binding Name}"
                                                     Command="{Binding DataContext.SelectButtonCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     CommandParameter="{Binding Index}">
                                            <Grid>
                                                <TextBlock Text="{Binding FunctionName}" FontSize="{DynamicResource CaptionTextBlockFontSize}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding TagX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding TagY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                    </Canvas>

                    <!-- 保存状态反馈 -->
                    <TextBlock Grid.Row="1" Text="{Binding SaveStatusText}" FontSize="{DynamicResource CaptionTextBlockFontSize}" Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ===== 右栏：分配功能面板（默认隐藏）。覆盖层——盖在左栏右侧，
                     左栏图片保持原尺寸平移被遮，不缩小。无独立背景，直接显示在大卡背景上。 ===== -->
                <Grid HorizontalAlignment="Right" Width="320" Panel.ZIndex="1"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <!-- 左缘竖分隔线：区分功能面板 -->
                    <Border Width="1" HorizontalAlignment="Left" Margin="0,16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ScrollViewer Margin="20,16,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="分配功能" Style="{DynamicResource CardTitleTextStyle}" />
                                <TextBlock Text="{Binding SelectedButton.Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource CaptionTextBlockFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <TabControl Margin="0,12,0,0" SelectedIndex="{Binding FuncTabIndex, Mode=OneWay}">
                                <!-- 鼠标操作 Tab：11 个已验证功能（含 DPI 循环），ListView 单选 -->
                                <TabItem Header="鼠标操作">
                                    <ListView x:Name="FuncList" ItemsSource="{Binding FuncOptions}"
                                              Style="{DynamicResource FuncOptionListStyle}"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding SelectedButtonFuncCode, Mode=OneWay}"
                                              SelectionChanged="OnFuncListSelectionChanged"
                                              Margin="0,8,0,0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource CaptionTextBlockFontSize}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </TabItem>

                                <!-- 宏 Tab：宏列表单选展示（不用下拉框）；列表为空时显示空态提示 -->
                                <TabItem Header="快捷指令">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="选择快捷指令" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <!-- 空态：宏列表为空时提示 -->
                                        <TextBlock Text="暂无快捷指令，请到「快捷指令」页创建" FontSize="{DynamicResource CaptionTextBlockFontSize}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 宏列表：每项单选，选中即绑定当前按钮的宏 ID -->
                                        <ItemsControl ItemsSource="{Binding Macros}" Margin="0,4,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="BtnMacro" Content="{Binding Name}" Margin="0,2"
                                                                 IsChecked="{Binding IsBindingSelected, Mode=OneWay}"
                                                                 Command="{Binding DataContext.SetMacroCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                 CommandParameter="{Binding Id}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="录制按键与播放方式请在「快捷指令」页编辑" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- 未逆向功能的说明（置灰原则：未确认编码绝不上 UI） -->
                            <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="4"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="DPI+ / 快捷键 / 多媒体 / 浏览器等功能等待协议补齐，暂不提供。"
                                           FontSize="{DynamicResource CaptionTextBlockFontSize}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
