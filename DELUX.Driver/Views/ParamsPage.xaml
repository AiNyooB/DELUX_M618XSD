<Page x:Class="DeluxDriver.ParamsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="参数设置">

    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <ScrollViewer Padding="24">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="参数设置" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="设置灯光效果与电源管理，兼顾个性与续航。"
                       Style="{DynamicResource PageSubtitleTextStyle}"
                       Margin="0,4,0,16" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xE827;" Style="{DynamicResource IconStyle}" />
                    <TextBlock Text="参数设置即将开放" Style="{DynamicResource CardTitleTextStyle}" Margin="0,12,0,4" />
                    <TextBlock Text="本模块将在「灯光 / 电源」阶段接入：灯光模式与休眠时间（电源操作为风险项，会有明确提示）。"
                               Style="{DynamicResource CardDescriptionTextStyle}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Page>
