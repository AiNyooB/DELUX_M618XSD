<Page x:Class="DeluxDriver.OtherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="其他设置">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="其他设置" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="恢复出厂设置、固件与设备信息等。"
                       Style="{DynamicResource PageSubtitleTextStyle}"
                       Margin="0,4,0,16" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xE713;" Style="{DynamicResource IconStyle}" />
                    <TextBlock Text="其他设置即将开放" Style="{DynamicResource CardTitleTextStyle}" Margin="0,12,0,4" />
                    <TextBlock Text="本模块将在「其他设置」阶段接入：一键恢复出厂默认、查看设备信息。"
                               Style="{DynamicResource CardDescriptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- 产品外观：白 / 黑 / 蓝（默认白色），本地设置，不写入设备 -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="产品外观" Style="{DynamicResource CardTitleTextStyle}" />
                    <TextBlock Text="选择鼠标示意图的配色，仅影响软件内的展示效果。"
                               Style="{DynamicResource CardDescriptionTextStyle}"
                               Margin="0,4,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 白色 -->
                        <Border Grid.Column="0" Margin="4" CornerRadius="10" Padding="2"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Appearance}" Value="White">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="{DynamicResource SelectionStrokeThickness}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0" Padding="10"
                                    Command="{Binding SetAppearanceCmd}" CommandParameter="white"
                                    Cursor="Hand">
                                <StackPanel>
                                    <Border Height="64" CornerRadius="{DynamicResource ImageCornerRadius}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="pack://application:,,,/Assets/m618xsd_white_top.png"
                                               Stretch="Uniform" Margin="8" />
                                    </Border>
                                    <TextBlock Text="白色" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- 黑色 -->
                        <Border Grid.Column="1" Margin="4" CornerRadius="10" Padding="2"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Appearance}" Value="Black">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="{DynamicResource SelectionStrokeThickness}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0" Padding="10"
                                    Command="{Binding SetAppearanceCmd}" CommandParameter="black"
                                    Cursor="Hand">
                                <StackPanel>
                                    <Border Height="64" CornerRadius="{DynamicResource ImageCornerRadius}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="pack://application:,,,/Assets/m618xsd_black_top.png"
                                               Stretch="Uniform" Margin="8" />
                                    </Border>
                                    <TextBlock Text="黑色" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- 蓝色 -->
                        <Border Grid.Column="2" Margin="4" CornerRadius="10" Padding="2"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Appearance}" Value="Blue">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="{DynamicResource SelectionStrokeThickness}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0" Padding="10"
                                    Command="{Binding SetAppearanceCmd}" CommandParameter="blue"
                                    Cursor="Hand">
                                <StackPanel>
                                    <Border Height="64" CornerRadius="{DynamicResource ImageCornerRadius}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="pack://application:,,,/Assets/m618xsd_blue_top.png"
                                               Stretch="Uniform" Margin="8" />
                                    </Border>
                                    <TextBlock Text="蓝色" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 主题 -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="主题"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{DynamicResource CardDescriptionTextStyle}"
                               Margin="0,4,0,12"
                               Text="选择浅色或深色界面，立即生效。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                Padding="10" Command="{Binding ThemeCmd}" CommandParameter="light">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE706;" Style="{DynamicResource IconStyle}" FontSize="16" />
                                <TextBlock Text="浅色" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Stretch"
                                Padding="10" Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding ThemeCmd}" CommandParameter="dark">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE708;" Style="{DynamicResource IconStyle}" FontSize="16" />
                                <TextBlock Text="深色" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
