<Page x:Class="DeluxDriver.OtherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DeluxDriver"
      Title="其他设置">

    <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：页面标题 + 各设置卡片 -->
            <StackPanel Grid.Column="0" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,24,0">
                <TextBlock Text="其他设置" Style="{DynamicResource PageTitleTextStyle}" />
                <TextBlock Text="电量、外观与维护等。"
                           Style="{DynamicResource PageSubtitleTextStyle}"
                           Margin="0,4,0,16" />

                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" Style="{DynamicResource IconStyle}" />
                        <TextBlock Text="其他设置即将开放" Style="{DynamicResource CardTitleTextStyle}" Margin="0,12,0,4" />
                        <TextBlock Text="本模块将在后续阶段接入：一键恢复出厂默认、查看设备信息。"
                                   Style="{DynamicResource CardDescriptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- 产品外观：白 / 黑 / 蓝（默认白色），本地设置，不写入设备。预览在内容区右侧。 -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="产品外观" Style="{DynamicResource CardTitleTextStyle}" />
                        <TextBlock Text="选择鼠标示意图的配色，仅影响软件内的展示效果。"
                                   Style="{DynamicResource CardDescriptionTextStyle}"
                                   Margin="0,4,0,16" />
                        <ComboBox SelectedValue="{Binding Appearance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="白色" Tag="{x:Static local:AppViewModel+ProductAppearance.White}" />
                            <ComboBoxItem Content="黑色" Tag="{x:Static local:AppViewModel+ProductAppearance.Black}" />
                            <ComboBoxItem Content="蓝色" Tag="{x:Static local:AppViewModel+ProductAppearance.Blue}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 主题：跟随设备（系统）/ 浅色 / 深色，立即生效。 -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{DynamicResource CardTitleTextStyle}" />
                        <TextBlock Style="{DynamicResource CardDescriptionTextStyle}"
                                   Margin="0,4,0,12"
                                   Text="选择界面明暗，跟随设备即随系统设置。" />
                        <ComboBox SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="跟随设备" Tag="{x:Static local:AppViewModel+ThemeModeKind.System}" />
                            <ComboBoxItem Content="浅色" Tag="{x:Static local:AppViewModel+ThemeModeKind.Light}" />
                            <ComboBoxItem Content="深色" Tag="{x:Static local:AppViewModel+ThemeModeKind.Dark}" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右栏：产品顶视图预览，随外观选择切换 -->
            <Border Grid.Column="1" VerticalAlignment="Top" Margin="0,56,0,0"
                    CornerRadius="{DynamicResource ImageCornerRadius}"
                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                    Height="220">
                <Image Source="{Binding AppearanceImageUri}" Stretch="Uniform" Margin="16" />
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
