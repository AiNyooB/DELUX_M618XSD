<Page
    x:Class="DeluxDriver.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="连接设备">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 行 0：文字区 ===== -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,24">

            <!-- 标题：5 态切换 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="请连接设备" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding ShowDefaultTitle, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="M618XSD连接中" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="鼠标已连接" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                <!-- 失败态：带重试按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding ShowReconnect, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="M618XSD连接失败" Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button Content="重试" Command="{Binding ReconnectCmd}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Height="28" Padding="10,0" FontSize="13"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="连接失败" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding ShowErrorTitle, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 副说明 -->
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitleTextStyle}">
                        <Setter Property="Text" Value="驱动无法识别蓝牙模式连接，请使用 2.4G 接收器或数据线" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Text" Value="已识别到 DELUX M618XSD，可从左侧进入各项设置。" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ===== 行 1：图片卡片 ===== -->
        <Grid Grid.Row="1" HorizontalAlignment="Center">

            <!-- 图片卡片：连接失败时背景变灰，图片和文字不变 -->
            <Border x:Name="ImageCard" MaxWidth="300"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Style.Triggers>
                            <!-- 连接失败或驱动冲突时卡片背景变灰 -->
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Background" Value="#E8E8E8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 图片容器：黄金比例，ProgressBar 叠加在顶部 -->
                    <Grid HorizontalAlignment="Stretch"
                          Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource GoldenRatio}}">
                        <Image Source="{Binding AppearanceImageUri}" Stretch="UniformToFill" StretchDirection="DownOnly"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TranslateTransform X="-24" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- ProgressBar 叠加在图片顶部 -->
                        <Border Height="4" VerticalAlignment="Top" Margin="0,0,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Stretch"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>