<Page
    x:Class="DeluxDriver.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="连接设备">

    <!-- 自动布局：图片按自身高度排布（软上限 MaxHeight，不超原图100%），文字区固定高度在下方，整体垂直居中 -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 图片区：高度自适应，最大 MaxHeight 软上限；Image 等比且仅缩小不放大（最大 100% 原图） -->
        <Border Grid.Row="0" CornerRadius="{DynamicResource OverlayCornerRadius}" Padding="12" Margin="48,0,48,12" HorizontalAlignment="Center"
                MaxHeight="420"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Image Source="{Binding AppearanceImageUri}" Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 文字区：固定内容高度，始终显示在图片下方 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460">
            <!-- 标题区：根据状态切换显示（Grid 叠加，同一位置只显示一个） -->
            <Grid>
                <!-- 默认空态 -->
                <TextBlock Text="请连接设备" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding ShowDefaultTitle, Converter={StaticResource BoolToVis}}" />
                <!-- 连接中 -->
                <TextBlock Text="正在识别鼠标" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <!-- 已连接（短暂显示后自动跳转） -->
                <TextBlock Text="鼠标已连接" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                <!-- 连接失败：文字提示 + 重新识别按钮 -->
                <StackPanel Visibility="{Binding ShowReconnect, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="未识别到鼠标" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <Button Content="重新识别" Command="{Binding ReconnectCmd}"
                            Style="{DynamicResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- 副说明 -->
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="驱动无法识别蓝牙模式连接，请使用 2.4G 接收器或数据线" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Text" Value="已识别到 DELUX M618XSD，可从左侧进入各项设置。" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 连接中提示 -->
            <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="0,18,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- 连接失败原因（只含错误文案 + 打开任务管理器，不含重新识别） -->
            <Border Margin="0,18,0,0" Style="{DynamicResource ErrorBannerStyle}"
                    Visibility="{Binding ConnectErrorVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectErrorText}" TextWrapping="Wrap"
                               Style="{DynamicResource ErrorBannerTextStyle}" />
                    <Button Content="打开任务管理器" Command="{Binding OpenTaskManagerCmd}"
                            Style="{DynamicResource TextButtonStyle}"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShowOpenTaskManager, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
