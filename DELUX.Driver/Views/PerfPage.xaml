<Page x:Class="DeluxDriver.PerfPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DeluxDriver"
      Title="性能设置">

    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="性能设置" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="调整回报率，让光标移动更跟手"
                       Style="{DynamicResource PageSubtitleTextStyle}"
                       Margin="0,4,0,16" />

            <!-- ══════════ 回报率仪表盘 ══════════ -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xEC1B;" Style="{DynamicResource IconStyle}" />
                        <TextBlock Text="回报率" Style="{DynamicResource CardTitleTextStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 单行四选一仪表盘 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 125 Hz · 省电模式 -->
                        <Border Grid.Column="0" Margin="4"
                                Padding="12,16" CornerRadius="{DynamicResource CardCornerRadius}"
                                Cursor="Hand"
                                Tag="125">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.CurrentRateHz, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     Value="{x:Static local:PerfPage.Rate125}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SetRateCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="125" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="125 Hz" FontSize="{DynamicResource SubtitleTextBlockFontSize}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="省电模式" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 250 Hz · 办公模式 -->
                        <Border Grid.Column="1" Margin="4"
                                Padding="12,16" CornerRadius="{DynamicResource CardCornerRadius}"
                                Cursor="Hand"
                                Tag="250">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.CurrentRateHz, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     Value="{x:Static local:PerfPage.Rate250}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SetRateCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="250" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="250 Hz" FontSize="{DynamicResource SubtitleTextBlockFontSize}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="办公模式" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 500 Hz · 游戏模式 -->
                        <Border Grid.Column="2" Margin="4"
                                Padding="12,16" CornerRadius="{DynamicResource CardCornerRadius}"
                                Cursor="Hand"
                                Tag="500">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.CurrentRateHz, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     Value="{x:Static local:PerfPage.Rate500}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SetRateCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="500" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="500 Hz" FontSize="{DynamicResource SubtitleTextBlockFontSize}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="游戏模式" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 1000 Hz · 电竞模式 -->
                        <Border Grid.Column="3" Margin="4"
                                Padding="12,16" CornerRadius="{DynamicResource CardCornerRadius}"
                                Cursor="Hand"
                                Tag="1000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource ControlStrokeThickness}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.CurrentRateHz, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     Value="{x:Static local:PerfPage.Rate1000}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SetRateCmd, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="1000" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="1000 Hz" FontSize="{DynamicResource SubtitleTextBlockFontSize}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="电竞模式" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存状态反馈 -->
            <TextBlock Text="{Binding SaveStatusText}" FontSize="{DynamicResource CaptionTextBlockFontSize}"
                       Margin="4,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Page>
