<Page x:Class="DeluxDriver.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="配置管理">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="配置管理" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="切换、保存或导入导出多套配置方案。"
                       Foreground="{DynamicResource SubForegroundBrush}"
                       Margin="0,4,0,16" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xE74E;" Style="{DynamicResource IconStyle}" />
                    <TextBlock Text="配置管理即将开放" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="本模块将在「配置管理」阶段接入：切换 Profile、保存/导入导出配置。"
                               TextWrapping="Wrap" Foreground="{DynamicResource SubForegroundBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
